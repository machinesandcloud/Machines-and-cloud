    {
      "step": 1,
      "title": "Your day, at a glance",
      "body": "Home shows requests, visits and work that needs your attention. Use Inbox for customer messages, Schedule for visits and Front desk for setup.",
      "action": "Explore Home"
    },
    {
      "step": 2,
      "title": "Make it sound like your shop",
      "body": "Your services, hours, prices and safety instructions guide every answer. Open a section to check or edit it, then review the saved version.",
      "action": "Review business details"
    },
    {
      "step": 3,
      "title": "Try it before customers do",
      "body": "Test answers with a customer question or visit request. This private conversation previews the details collected without real bookings, messages or calendar changes.",
      "action": "Open Test answers"
    },
    {
      "step": 4,
      "title": "Keep your schedule accurate",
      "body": "Schedule holds your saved visits and blocked time. Block dates or windows for outside work. Existing visits stay booked; outside calendar busy times are not synced automatically.",
      "action": "View Schedule"
    },
    {
      "step": 5,
      "title": "Put it on your website",
      "body": "Follow the next step shown here to install and check your website chat. Copying the code alone does not confirm it is installed or answering customers.",
      "action": "View website setup"
    },
    {
      "step": 6,
      "title": "Find your customer requests",
      "body": "Inbox keeps customer requests and conversations together. Review what the customer needs, then confirm the next step directly. Saved visits are in Schedule.",
      "action": "View Requests"
    }
  ],
