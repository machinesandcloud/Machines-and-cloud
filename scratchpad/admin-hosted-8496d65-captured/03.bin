:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172740;background:#f5f7fb;font-synthesis:none;line-height:1.5}
*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button,a{touch-action:manipulation}a{color:#2455df}button{cursor:pointer}button:disabled{cursor:wait;opacity:.55}button,input,select,textarea{min-height:44px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:3px solid #8baeff;outline-offset:3px}[hidden]{display:none!important}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(1.8rem,3vw,2.4rem);line-height:1.15;letter-spacing:-.055em;margin-bottom:10px}h2{font-size:1.15rem;letter-spacing:-.025em;margin-bottom:12px}h3{font-size:1rem;margin-bottom:8px}p{line-height:1.65}.muted{color:#65738a;font-size:.875rem}.eyebrow{font-size:.7rem;font-weight:750;letter-spacing:.14em;text-transform:uppercase;color:#637a9c;margin-bottom:8px}.app-shell{min-height:100vh;display:grid;grid-template-columns:224px minmax(0,1fr)}.side{background:#12243e;color:#c6d3e7;padding:28px 18px;display:flex;flex-direction:column;gap:26px}.brand{display:block;padding:0 10px;text-decoration:none;color:#fff;font-weight:700;font-size:1.1rem}.brand span{display:block;font-size:.72rem;color:#9cb1cd;font-weight:500;margin-top:4px}.side nav{display:grid;gap:6px}.side nav button{border:0;border-radius:9px;background:none;text-align:left;color:#b9cae0;padding:11px 14px;font-size:.875rem;font-weight:550}.side nav button[aria-current=page]{background:#274265;color:#fff}.side nav button:hover{background:#203b5d}.side-footer{margin-top:auto;font-size:.75rem;line-height:1.6;padding:0 10px;color:#91a8c8}.main-area{min-width:0;padding:26px clamp(18px,4vw,54px) 64px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-bottom:24px;margin-bottom:20px;border-bottom:1px solid #e1e7f0;flex-wrap:wrap}.topbar p{margin:0;font-size:.8rem;color:#65738a}.topbar-actions,.actions,.filters{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid #d8e1ef;border-radius:8px;background:#fff;color:#263a56;padding:10px 16px;text-decoration:none;font-size:.82rem;font-weight:650;line-height:1.35}.btn:hover{background:#f5f8ff}.btn.primary{background:#2455df;border-color:#2455df;color:#fff}.btn.primary:hover{background:#1848c7}.btn.danger{color:#b42335;border-color:#f0ccd2}.btn.quiet{background:none}.btn.small{padding:8px 12px;font-size:.75rem}.page-head{margin-bottom:26px}.page-head p{margin-bottom:0;max-width:660px;color:#65738a;font-size:.92rem}.panel{border:1px solid #e0e7f1;border-radius:14px;background:#fff;padding:23px;margin-bottom:20px;min-width:0}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:14px;flex-wrap:wrap;margin-bottom:16px}.panel-head h2,.panel-head p{margin-bottom:0}.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:24px}.stat{background:#fff;border:1px solid #e0e7f1;border-radius:12px;padding:20px}.stat b{display:block;font-size:1.9rem;font-weight:650;letter-spacing:-.05em;margin-bottom:3px}.stat span{font-size:.78rem;color:#65738a}.stat.attention b{color:#ab5613}.two-columns{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:20px}.notice{border:1px solid #d6e2ff;background:#eff4ff;border-radius:9px;padding:12px 15px;color:#304b79;font-size:.85rem;line-height:1.6;margin-bottom:18px}.notice.error{border-color:#f0c5ce;background:#fff2f4;color:#9d2639}.notice.success{border-color:#bee4d0;background:#f0fbf5;color:#226244}.empty{padding:28px 12px;text-align:center;color:#6c7a91;font-size:.9rem}.record-list{list-style:none;padding:0;margin:0}.record-list>li{padding:14px 0;border-bottom:1px solid #edf1f7}.record-list>li:last-child{border-bottom:0}.record-top{display:flex;justify-content:space-between;align-items:start;gap:12px;flex-wrap:wrap}.record-top b{font-size:.9rem}.record-list p{margin:5px 0 0;font-size:.82rem;color:#65738a;overflow-wrap:anywhere}.badge{display:inline-flex;align-items:center;padding:4px 9px;border-radius:6px;background:#edf1f7;color:#536781;font-size:.7rem;font-weight:650;white-space:nowrap}.badge.good{color:#26714c;background:#e9f7ef}.badge.warn{color:#98601c;background:#fff4df}.badge.bad{color:#ac2940;background:#fff0f3}.field{display:grid;gap:7px;min-width:0}.field label{font-size:.78rem;font-weight:650;color:#405674}.field input,.field select,.field textarea{width:100%;border:1px solid #cfdaeb;background:#fff;color:#1b2f4d;border-radius:8px;padding:10px 12px;font-size:.9rem;min-width:0}.field textarea{min-height:100px;resize:vertical}.filters{margin-bottom:20px;align-items:end}.filters .field:first-child{flex:1;min-width:160px}.filters .field{min-width:150px}.table-scroll{max-width:100%;overflow-x:auto;border:1px solid #e4eaf3;border-radius:10px}.data-table{width:100%;border-collapse:collapse;font-size:.8rem;min-width:650px}.data-table th{font-size:.68rem;font-weight:650;text-transform:uppercase;letter-spacing:.07em;color:#6a7c94;background:#f7f9fc;text-align:left;padding:13px 15px}.data-table td{padding:16px 15px;border-top:1px solid #edf1f7;vertical-align:middle}.data-table td small{display:block;color:#708198;margin-top:3px;font-size:.72rem}.data-table .customer-name{border:0;background:none;padding:0;min-height:44px;text-align:left;color:#234dba;font-weight:650}.customer-name:hover{text-decoration:underline}.detail-head{display:flex;justify-content:space-between;align-items:start;gap:16px;flex-wrap:wrap}.detail-title{font-size:1.65rem;margin-bottom:6px}.detail-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr);gap:20px}.facts{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:0}.facts div{min-width:0}.facts dt{font-size:.72rem;color:#74849b;margin-bottom:4px}.facts dd{margin:0;font-size:.85rem;overflow-wrap:anywhere}.channel-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.channel-card{border:1px solid #e1e8f3;border-radius:10px;padding:15px}.channel-card h3{font-size:.85rem;margin:10px 0 5px}.channel-card p{font-size:.78rem;color:#65738a;margin:0;line-height:1.6}.login-wrap{max-width:440px;margin:clamp(45px,12vh,140px) auto;padding:0 20px}.login-logo{font-weight:750;font-size:1.1rem;margin-bottom:34px;color:#1b2f4f}.login-wrap h1{font-size:2rem}.login-wrap .field{margin:20px 0 14px}.login-wrap .btn.primary{width:100%}.login-wrap .notice{margin-top:18px}.login-wrap .muted{margin-top:24px;font-size:.78rem}.action-form{display:grid;gap:14px}.action-form .actions{margin-top:3px}.operation-line{border:1px solid #e1e8f3;padding:15px;border-radius:10px;margin-bottom:10px}.operation-line p{margin:7px 0;font-size:.82rem;color:#65738a}.page-status{min-height:22px;font-size:.8rem;color:#65738a}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#182b46;color:#fff;padding:12px 18px;border-radius:9px;font-size:.82rem;max-width:calc(100% - 32px);z-index:10}.mono{font:12px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.back-button{margin-bottom:18px}.timestamp{font-size:.72rem;color:#7b8ba0}dialog{max-width:520px;width:calc(100% - 32px);border:1px solid #d8e2f1;border-radius:16px;padding:26px;color:#172740}dialog::backdrop{background:#142b4b80}dialog .actions{margin-top:20px}
@media(max-width:1100px){.app-shell{grid-template-columns:186px minmax(0,1fr)}.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid,.two-columns{grid-template-columns:1fr}.side{padding:24px 12px}.main-area{padding:24px 24px 50px}}
@media(max-width:700px){.app-shell{display:block}.side{padding:15px 16px;gap:14px}.brand{padding:0}.brand span{display:none}.side nav{display:flex;gap:5px;overflow:auto;margin:0 -4px;padding:3px 4px}.side nav button{flex:none;padding:9px 12px;white-space:nowrap;min-height:42px;font-size:.8rem}.side-footer{display:none}.main-area{padding:18px 16px 48px}.topbar{padding-bottom:16px;margin-bottom:22px;gap:12px}.topbar-actions{width:100%;justify-content:space-between;gap:8px}.stat-grid{gap:10px}.stat{padding:16px}.stat b{font-size:1.65rem}.panel{padding:18px}.channel-grid{grid-template-columns:1fr}.facts{gap:14px}.filters{align-items:stretch;gap:12px}.filters .field{flex:1;min-width:130px}.filters .field:first-child{flex-basis:100%}.btn{font-size:.8rem;padding:10px 13px}.field input,.field select,.field textarea{font-size:16px}.page-head{margin-bottom:20px}.data-table td,.data-table th{padding-left:12px;padding-right:12px}.table-scroll{border-radius:8px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
