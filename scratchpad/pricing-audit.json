  "findings": [
    {
      "id": "PA-01",
      "priority": "P1 current copy / P0 before paid activation",
      "finding": "Six legacy offer pages contradict free untimed web-workspace setup with timed free week, live-in-seven-days and unactivated phone/lead features."
    },
    {
      "id": "PA-02",
      "priority": "P1",
      "finding": "Monthly paid plan cards do not disclose plan-independent daily AI ceilings or shared exhaustion. No current visible literal unlimited claim was found."
    },
    {
      "id": "PA-03",
      "priority": "P1",
      "finding": "Custom rules and customer CSV export are available to every new workspace; leadPlatforms/software declarations are not enforced paid entitlements; priority support has no measured contract."
    },
    {
      "id": "PA-04",
      "priority": "P0 before paid activation",
      "finding": "Meter rounds per call, counts repeated reports again, lacks atomic usage increments and defaults failed reads to zero; not an invoicing ledger."
    },
    {
      "id": "PA-05",
      "priority": "P0 before paid activation",
      "finding": "Text meter counts outbound logical sends, not carrier segments; owner/inbound sends and maintenance/consent types are excluded; disabled sends can count."
    },
    {
      "id": "PA-06",
      "priority": "P0 before paid activation",
      "finding": "No overage billing reconciliation/tax configuration/proration/price-change contract established. Legacy checkout can fall back to Growth price while storing another plan; missing new-marker webhook guard."
    },
    {
      "id": "PA-07",
      "priority": "P1 future economics",
      "finding": "Full-use Pro reduces revenue per bundled unit; margins require measured all-in voice, segment, AI, support/fixed costs. Pricing alone cannot establish profitability."
    },
    {
      "id": "PA-08",
      "priority": "P1 before sales comparison promise",
      "finding": "Sales calculator compares only continuous routed minutes; explicit exclusions cover taxes/texts but per-call billing rounding is not modeled."
    }
  ],
