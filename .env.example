# Copy the keys you have into Netlify > Site settings > Environment variables. Never commit real values.
ANTHROPIC_API_KEY=
ADMIN_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PRIMARY_PROFILE_SID=
TWILIO_NOTIFY_EMAIL=
MC_MESSAGING_SERVICE_SID=
VAPI_API_KEY=
VAPI_MODEL=claude-sonnet-5
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_WEBHOOK_SECRET=
MC_TWILIO_NUMBER=
STEVE_PHONE=
STEVE_EMAIL=support@machinesandcloud.com
RESEND_API_KEY=
FROM_EMAIL=Machines & Cloud <desk@machinesandcloud.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Fallbacks when our functions do not answer (one-time Twilio console setup, OPERATIONS.md): static TwiML Bins.
VOICE_FALLBACK_TWIML_URL=
SMS_FALLBACK_TWIML_URL=

# Set to the date a Spanish speaker reviewed the Spanish texts; until then the admin page lists the review as pending.
SPANISH_REVIEWED_ON=

# Model for the nightly rubric pass (default claude-opus-5-5); see DECISIONS.md for the measured precision and recall per model.
RUBRIC_MODEL=

# Public sales adviser: accepted logical turns per Houston day; failures consume allowance.
# Independent of customer/private AI. 0 stops new sales starts; invalid values fail closed.
# Global: 0..500 (default50). Per-IP: 0..100 (default20). Up to3 model requests per turn.
MC_SALES_AI_GLOBAL_DAILY_LIMIT=50
MC_SALES_AI_IP_DAILY_LIMIT=20
