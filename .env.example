# Copy the keys you have into Netlify > Site settings > Environment variables. Never commit real values.
ANTHROPIC_API_KEY=
ADMIN_KEY=
# Comma-separated verified operator mailboxes. Required for the admin portal;
# separate operator links/sessions never grant customer owner access.
ADMIN_EMAILS=
# Optional private manual recovery trigger; automatic scheduler recovery needs no key.
WORKSPACE_WORKER_KEY=
# Number-acquisition execution stays off until the versioned offer and provider
# acceptance are approved. Saving connection preferences never authorizes cost.
PHONE_ACQUISITION_ENABLED=false
PHONE_ACTIVATION_APPROVED_VERSION=
PHONE_ACTIVATION_OFFER_JSON=
# Server-only number/brand/campaign creation admission. Blank blocks new managed
# resource purchases/filings. No assumed provider rates or automatic budget reset.
# Existing reconciliation/cleanup keeps its original authority and provider gates.
MANAGED_RESOURCE_ADMISSION_APPROVED_VERSION=
MANAGED_RESOURCE_ADMISSION_POLICY_JSON=
# Managed service execution remains off until its policy and real provider acceptance pass.
MC_PLATFORM_SMS_ENABLED=false
# Generate separate 32-byte base64 encryption keys; keep all three secrets in Functions scope.
SERVICE_WORKER_KEY=
PLATFORM_DATA_ENCRYPTION_KEY=
CALENDAR_TOKEN_ENCRYPTION_KEY=
SERVICE_DELIVERY_ENABLED=false
# Server-only outbound SMS self-service policy (or proof cohort) and cumulative allowance.
# Missing/invalid policy blocks sends, including setup texts. No default rates.
# Exact schema, upper-bound assumptions and retained lifetime counters: OPERATIONS.md.
MANAGED_SMS_BUDGET_APPROVED_VERSION=
MANAGED_SMS_BUDGET_POLICY_JSON=
CALENDAR_CONNECTION_ENABLED=false
CALENDAR_DELIVERY_ENABLED=false
# Private, exact-tenant Calendar execution approval. Both flags above still apply.
# See product/SPRINT20.md; an absent/expired policy makes Calendar unavailable.
CALENDAR_EXECUTION_APPROVED_VERSION=
CALENDAR_EXECUTION_POLICY_JSON=
VOICE_ACTIVATION_ENABLED=false
VOICE_ACTIVATION_APPROVED_VERSION=
VOICE_ACTIVATION_POLICY_JSON=
MESSAGING_ACTIVATION_ENABLED=false
MESSAGING_ACTIVATION_APPROVED_VERSION=
MESSAGING_ACTIVATION_OFFER_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PRIMARY_PROFILE_SID=
TWILIO_NOTIFY_EMAIL=
MC_MESSAGING_SERVICE_SID=
VAPI_API_KEY=
VAPI_MODEL=claude-sonnet-5
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_WEBHOOK_SECRET=
MC_TWILIO_NUMBER=
STEVE_PHONE=
STEVE_EMAIL=support@machinesandcloud.com
RESEND_API_KEY=
FROM_EMAIL=Machines & Cloud <desk@machinesandcloud.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Fallbacks when our functions do not answer (one-time Twilio console setup, OPERATIONS.md): static TwiML Bins.
VOICE_FALLBACK_TWIML_URL=
SMS_FALLBACK_TWIML_URL=

# Set to the date a Spanish speaker reviewed the Spanish texts; until then the admin page lists the review as pending.
SPANISH_REVIEWED_ON=

# Model for the nightly rubric pass (default claude-opus-5-5); see DECISIONS.md for the measured precision and recall per model.
RUBRIC_MODEL=

# Public sales adviser: accepted logical turns per Houston day; failures consume allowance.
# Independent of customer/private AI. 0 stops new sales starts; invalid values fail closed.
# Global: 0..500 (default50). Per-IP: 0..100 (default20). Up to3 model requests per turn.
MC_SALES_AI_GLOBAL_DAILY_LIMIT=50
MC_SALES_AI_IP_DAILY_LIMIT=20

# Customer Calendar admission; separate from the named internal proof policy.
# Keep disabled until the grouped application and live owner-granted delivery are accepted.
# Policy schema and non-refundable global/tenant daily limits are documented in OPERATIONS.md.
CALENDAR_SELF_SERVICE_ENABLED=false
CALENDAR_SELF_SERVICE_APPROVED_VERSION=
CALENDAR_SELF_SERVICE_POLICY_JSON=
