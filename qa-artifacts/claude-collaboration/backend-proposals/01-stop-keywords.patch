+// Shared inbound SMS keyword classifier for the platform line and supported shop numbers.
+// CTIA Messaging Principles (May 2023) 5.1.3: opt-out validity "should not be impacted by any
+// de minimis variances ... such as capitalization, punctuation, or any letter-case sensitivities",
+// and normal language ("stop", "end", "unsubscribe", "cancel", "quit", "please opt me out") should be
+// acted on "except where a specific word can result in unintentional opt-out".
+//
+// Rule (conservative):
+// 1. Normalize: Unicode NFKD, drop accents, uppercase, turn every character that is not a letter,
+//    digit or in-word apostrophe into a space, collapse spaces, join OPT[-/ ][ME ]OUT into OPTOUT.
+// 2. Exact keyword: the normalized message equals one keyword (STOP/START/HELP lists below).
+// 3. Short opt-out phrase: at most 6 words, at least one strong opt-out word (STOP, STOPALL,
+//    UNSUBSCRIBE, OPTOUT, QUIT, ALTO, PARAR) and every other word from a small courtesy/object list
+//    (PLEASE, ME, TEXTING, MESSAGES, NOW, POR, FAVOR, ...). "please stop texting me" is an opt-out;
+//    "the leak won't stop" and "can you stop by" are not, because THE/LEAK/WON'T/BY are not
+//    courtesy words. CANCEL, END and REVOKE count only as exact single keywords, because
+//    "cancel my appointment" or "end of the day" are ordinary service messages.
+//    A few whole-message phrases without a keyword word ("remove me", "no more texts",
+//    "no más mensajes") are also exact opt-outs.
+// START and HELP never use the phrase rule ("help me with my furnace" is a question).
+// Consent-granting replies (YES, SI, SÍ) are deliberately not handled here and stay exact.
+export const SMS_KEYWORDS = Object.freeze({
+  stop: Object.freeze(['STOP','STOPALL','UNSUBSCRIBE','CANCEL','END','QUIT','REVOKE','OPTOUT','ALTO','PARAR']),
+  start: Object.freeze(['START','UNSTOP','EMPEZAR']), help: Object.freeze(['HELP','INFO','AYUDA'])
+});
+const PHRASE_STOP = new Set(['STOP','STOPALL','UNSUBSCRIBE','OPTOUT','QUIT','ALTO','PARAR']);
+const COURTESY = new Set([
+  'PLEASE','PLS','PLZ','NOW','JUST','ME','MY','NUMBER','TEXT','TEXTS','TEXTING','MESSAGE','MESSAGES','MESSAGING',
+  'SENDING','SEND','CONTACTING','ALL','IT','THE','THIS','THESE','THEM','TO','FROM','LIST','THANKS','THANK','YOU','THX','TY','OK','OKAY',
+  'POR','FAVOR','YA','DE','LOS','MENSAJES','MENSAJE','TEXTOS','ENVIAR','MANDAR','GRACIAS','MAS'
+]);
+// Whole-message opt-out phrases without a keyword word (still exact after normalization).
+const STOP_PHRASES = new Set(['REMOVE ME','DO NOT TEXT ME',"DON'T TEXT ME",'NO MORE TEXTS','NO MORE MESSAGES','NO MAS MENSAJES','NO ME ESCRIBAN','NO ME MANDEN MENSAJES','NO ME MANDEN MAS MENSAJES']);
+const MAX_PHRASE_WORDS = 6;
+export function normalizeSMSKeywordText(text) {
+  return String(text ?? '').slice(0, 1600).normalize('NFKD').replace(/\p{M}+/gu, '').toUpperCase()
+    .replace(/[‘’ʼ]/g, "'")
+    .replace(/[^\p{L}\p{N}']+/gu, ' ').replace(/(^|\s)'+|'+(?=\s|$)/g, '$1')
+    .replace(/\bOPT(?:\s+ME)?\s+OUT\b/g, 'OPTOUT').replace(/\s+/g, ' ').trim();
+}
+// Returns 'stop' | 'start' | 'help' | null. STOP wins over START and HELP.
+export function classifySMSKeyword(text) {
+  const normal = normalizeSMSKeywordText(text);
+  if (!normal) return null;
+  if (SMS_KEYWORDS.stop.includes(normal)) return 'stop';
+  if (SMS_KEYWORDS.start.includes(normal)) return 'start';
+  if (SMS_KEYWORDS.help.includes(normal)) return 'help';
+  if (STOP_PHRASES.has(normal)) return 'stop';
+  const words = normal.split(' ');
+  if (words.length <= MAX_PHRASE_WORDS && words.some(word => PHRASE_STOP.has(word)) && words.every(word => PHRASE_STOP.has(word) || COURTESY.has(word))) return 'stop';
+  return null;
+}
