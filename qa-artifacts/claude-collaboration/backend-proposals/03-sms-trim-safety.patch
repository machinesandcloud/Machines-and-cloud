+
+// Last-resort filter for the model's own notes at the start of the final SMS reply (S1-21).
+// Text written before a tool call normally never reaches this point: runAgent with dropToolPreamble keeps only
+// turns that did not stop for a tool call. (Residual: a turn cut off by max_tokens or a refusal keeps its text.)
+// The old word-list trim ("call", "now", "have"...) also deleted safety instructions such as
+// "Call 911 and get everyone outside now." (AI review R1), so only shapes that no customer instruction can take
+// are removed, sentence by sentence (a newline also ends a sentence) from the start:
+//   - a sentence naming an internal tool (book_visit, notifyOwner) or starting "now/next/then/call ... notify owner";
+//     inside such a sentence only the ";"-separated clauses that name the tool are removed;
+//   - a bare field checklist: "Have name, address, issue, window.", "Phone filled automatically.",
+//     "Next ask window.", "Have address; emergency flagged.";
+//   - two exact notes: "Now flag emergency." and "Book it now."
+const TOOL_ID = /\b(?:book_visit|notify_owner|update_visit|get_availability|bookVisit|notifyOwner|updateVisit|getAvailability|flagLead)\b/;
+const TOOL_PHRASE = /^(?:(?:now|next|then)[,:]?\s+(?:(?:call|calling|use|using|run|running)\s+)?|(?:call|calling|use|using|run|running)\s+)(?:book visit|notify owner|update visit|get availability)\b/i;
+const FIELD = "(?:customer\\s+)?(?:name|phone(?:\\s+number)?|number|address|issue|problem|window|date|time|email|zip|urgency)";
+const STATUS = "(?:[a-z]+\\s+)?(?:flagged|filled|captured|collected|confirmed|noted|set)(?:\\s+automatically)?";
+const SEGMENT = `(?:${FIELD}(?:\\s+${STATUS})?|[a-z]+\\s+(?:flagged|noted))`;
+const CHECKLIST = new RegExp(`^(?:(?:now|next|then|ok|okay)[,:]?\\s+)?(?:(?:have|got|need|still need|missing|ask(?:\\s+for)?|collect)\\s*:?\\s+)?${SEGMENT}(?:\\s*(?:,|;|/|&|\\band\\b)\\s*${SEGMENT})*$`, "i");
+const FLAG_NOTE = /^(?:(?:now\s+)?flag(?:ging)?\s+(?:as\s+)?(?:emergency|urgent|lead|spam)|(?:now\s+)?book(?:ing)?\s+it(?:\s+now)?)$/i;
+const namesTool = (t) => TOOL_ID.test(t) || TOOL_PHRASE.test(t);
+function isPlanningSentence(sentence) {
+  const t = sentence.trim();
+  if (!t || /\?$/.test(t)) return false;
+  if (namesTool(t)) return true;
+  const bare = t.replace(/[.!]+$/, "").trim();
+  if (FLAG_NOTE.test(bare)) return true;
+  if (!CHECKLIST.test(bare)) return false;
+  // A single bare field word ("Address.") is too short to be sure; require a verb, a list or a status.
+  return /\b(?:have|got|need|missing|ask|collect|flagged|filled|captured|collected|confirmed|noted|set)\b/i.test(bare) || /[,;/&]|\band\b/i.test(bare);
+}
+// The first sentence of `text`: up to . ! ? followed by whitespace, or up to a newline.
+function leadSentence(text) {
+  const m = text.match(/^[^\n]*?[.!?](?=\s)|^[^\n]+(?=\n)/);
+  return m ? m[0] : text;
+}
+function dropPlanningLead(reply) {
+  let rest = reply.trim();
+  const dropped = [];
+  while (true) {
+    const first = leadSentence(rest);
+    if (first === rest || !isPlanningSentence(first)) break;
+    // "Call 911; notify_owner done.": keep the clauses that do not name a tool.
+    const clauses = first.replace(/[.!]+$/, "").split(/\s*;\s*/);
+    const keep = namesTool(first) && clauses.length > 1 ? clauses.filter((x) => !namesTool(x) && !isPlanningSentence(x)) : [];
+    dropped.push(keep.length ? clauses.filter((x) => !keep.includes(x)).join("; ") : first);
+    rest = (keep.length ? keep.join("; ") + "." : "") + (keep.length ? " " : "") + rest.slice(first.length).trimStart();
+    if (keep.length) break;
+  }
+  return rest.length > 10 && dropped.length ? { kept: rest, dropped } : { kept: reply, dropped: [] };
+}
