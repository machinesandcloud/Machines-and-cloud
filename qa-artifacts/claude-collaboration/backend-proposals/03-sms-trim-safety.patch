+
+// Last-resort filter for the model's own notes at the start of the final SMS reply (S1-21).
+// Text written before a tool call never reaches this point: runAgent with dropToolPreamble keeps only
+// the final, non-tool turn. The old word-list trim ("call", "now", "have"...) also deleted safety
+// instructions such as "Call 911 and get everyone outside now." (AI review R1), so only two shapes
+// that no customer instruction can take are removed, sentence by sentence from the start:
+//   - a sentence naming an internal tool (book_visit, notifyOwner, "Now call book visit.");
+//   - a bare field checklist: "Have name, address, issue, window.", "Phone filled automatically.",
+//     "Next ask window.", "Have address; emergency flagged.", "Have issue: water heater leaking.",
+//     "Now flag emergency.", "Book it now."
+const TOOL_ID = /\b(?:book_visit|notify_owner|update_visit|get_availability|bookVisit|notifyOwner|updateVisit|getAvailability|flagLead)\b/;
+const TOOL_PHRASE = /^(?:(?:now|next|then)[,:]?\s+)?(?:(?:call|calling|use|using|run|running)\s+)?(?:book visit|notify owner|update visit|get availability)\b/i;
+const FIELD = "(?:customer\\s+)?(?:name|phone(?:\\s+number)?|number|address|issue|problem|window|date|time|email|zip|urgency)";
+const STATUS = "(?:[a-z]+\\s+)?(?:flagged|filled|captured|collected|confirmed|noted|set)(?:\\s+automatically)?";
+const SEGMENT = `(?:${FIELD}(?:\\s+${STATUS})?|[a-z]+\\s+(?:flagged|noted))`;
+const CHECKLIST = new RegExp(`^(?:(?:now|next|then|ok|okay)[,:]?\\s+)?(?:(?:have|got|need|still need|missing|ask(?:\\s+for)?|collect)\\s*:?\\s+)?${SEGMENT}(?:\\s*(?:,|;|/|&|\\band\\b)\\s*${SEGMENT})*$`, "i");
+const FLAG_NOTE = /^(?:(?:now\s+)?flag(?:ging)?\s+(?:as\s+)?(?:emergency|urgent|lead|spam)|(?:now\s+)?book(?:ing)?\s+it(?:\s+now)?)$/i;
+// A labelled note: "Have issue: water heater leaking." (field name, colon, value).
+const LABEL_NOTE = new RegExp(`^(?:have|got)\\s+${FIELD}\\s*:\\s*\\S`, "i");
+function isPlanningSentence(sentence) {
+  const t = sentence.trim();
+  if (!t || /\?$/.test(t)) return false;
+  if (TOOL_ID.test(t) || TOOL_PHRASE.test(t)) return true;
+  const bare = t.replace(/[.!]+$/, "").trim();
+  if (FLAG_NOTE.test(bare) || LABEL_NOTE.test(bare) || isFieldValueNote(bare)) return true;
+  if (!CHECKLIST.test(bare)) return false;
+  // A single bare field word ("Address.") is too short to be sure; require a verb, a list or a status.
+  return /\b(?:have|got|need|missing|ask|collect|flagged|filled|captured|collected|confirmed|noted|set)\b/i.test(bare) || /[,;/&]|\band\b/i.test(bare);
+}
+// "Got address, gas furnace.": a field checklist followed by short noun phrases. Any word that could
+// start or carry an instruction to the customer keeps the sentence.
+const FIELD_RE = new RegExp(`^${FIELD}$`, "i");
+const INSTRUCTION = /^(?:get|leave|call|go|stay|open|turn|shut|keep|move|exit|don'?t|do|please|now|out|outside|away|you|your|everyone|everybody|no|not|never|use|touch|light|evacuate|salga|llame|no)$/i;
+function isFieldValueNote(bare) {
+  const m = bare.match(/^(?:have|got)\s+(.+)$/i);
+  if (!m || bare.split(/\s+/).length > 7) return false;
+  const segments = m[1].split(/\s*,\s*/);
+  if (segments.length < 2 || !FIELD_RE.test(segments[0])) return false;
+  return segments.slice(1).every((seg) => /^[a-z][a-z' -]*$/i.test(seg) && seg.split(/\s+/).length <= 3 && !seg.split(/\s+/).some((w) => INSTRUCTION.test(w)));
+}
+function dropPlanningLead(reply) {
+  const parts = reply.split(/(?<=[.!?])\s+/);
+  const dropped = [];
+  while (parts.length > 1 && isPlanningSentence(parts[0])) dropped.push(parts.shift());
+  const kept = parts.join(" ").trim();
+  return kept.length > 10 ? { kept, dropped } : { kept: reply, dropped: [] };
+}
