+
+// The first-sentence trim above (S1-21) removes leftover planning notes such as "Have name, address,
+// issue, window." It must never remove life-safety guidance, which the prompt tells the model to put
+// first ("Call 911 and get everyone outside now."). A sentence that names a tool is always planning.
+const SAFETY_WORDS = /\b(911|emergenc\w*|gas|leave|leaving|outside|evacuat\w*|fire|smoke|carbon monoxide|monoxide|get (?:everyone |everybody |the kids |yourself )?out|out of the (?:house|home|building)|emergencia|salga\w*|salir|afuera|incendio|humo|monoxido|monóxido)\b/i;
+const TOOL_NAME = /\b(book_visit|notify_owner|update_visit|get_availability)\b/;
+const DEFAULT_SAFETY_SCRIPT = "Leave the area now, call 911 if there is any danger, then call us back.";
+const plain = (s) => String(s || "").toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, " ").trim();
+function isSafetySentence(c, sentence) {
+  if (TOOL_NAME.test(sentence)) return false;
+  if (SAFETY_WORDS.test(sentence) || /\bCO\b/.test(sentence)) return true;
+  // The owner's configured safety script (rules.emergencies.script, or the old string form, as
+  // normalizeEmergencies reads it), else the default script; quoted in whole or in part.
+  const e = c?.rules?.emergencies;
+  const raw = String((typeof e === "string" ? e : e?.script) || "").slice(0, 500) || DEFAULT_SAFETY_SCRIPT;
+  const s = ` ${plain(sentence)} `, script = ` ${plain(raw)} `;
+  const long = (x) => x.trim().split(" ").length >= 3;
+  if (long(s) && script.includes(s)) return true;
+  return raw.split(/(?<=[.!?])\s+/).map((x) => ` ${plain(x)} `).some((x) => long(x) && s.includes(x));
+}
